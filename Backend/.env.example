# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mealplanner

# Security
AUTH_SECRET=dev-secret-change-me-in-production

# AI API Configuration
