OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
